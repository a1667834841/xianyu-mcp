#!/usr/bin/env python3

import json
import os
import sys
from urllib import error
from urllib import parse
from urllib import request


STREAMABLE_HTTP_ACCEPT = "application/json, text/event-stream"


def coerce_value(raw):
    lowered = raw.lower()
    if lowered == "true":
        return True
    if lowered == "false":
        return False
    if lowered == "null":
        return None

    try:
        return int(raw)
    except ValueError:
        pass

    try:
        return float(raw)
    except ValueError:
        pass

    return raw


STRING_ARGUMENT_KEYS = {
    "conversation_id",
    "target_id",
    "user_id",
    "item_id",
    "seller_id",
    "t",
    "ck",
}


def parse_call_args(argv):
    if not argv:
        raise ValueError("missing tool name")

    tool_name = argv[0]
    arguments = {}
    index = 1
    while index < len(argv):
        key = argv[index]
        if not key.startswith("--"):
            raise ValueError(f"invalid argument: {key}")
        if index + 1 >= len(argv):
            raise ValueError(f"missing value for {key}")

        argument_key = key[2:].replace("-", "_")
        raw_value = argv[index + 1]
        arguments[argument_key] = raw_value if argument_key in STRING_ARGUMENT_KEYS else coerce_value(raw_value)
        index += 2

    return tool_name, arguments


def build_request_payload(tool_name, arguments):
    return {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
            "name": tool_name,
            "arguments": arguments,
        },
    }


def extract_output_text(response_payload):
    if "error" in response_payload:
        raise RuntimeError(json.dumps(response_payload["error"], ensure_ascii=False))

    result = response_payload.get("result") or {}
    content = result.get("content") or []
    texts = [item.get("text", "") for item in content if item.get("type") == "text"]
    output_text = "\n".join(part for part in texts if part)
    if output_text:
        return output_text

    if "structuredContent" in result:
        return json.dumps(result["structuredContent"], ensure_ascii=False)

    if content:
        return json.dumps(content, ensure_ascii=False)

    return ""


def get_mcp_url():
    return os.environ.get("MCP_DEV_URL") or (
        f"http://127.0.0.1:{os.environ.get('MCP_HOST_PORT', '8080')}/mcp"
    )


def build_initialize_payload():
    return {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
            "protocolVersion": "2024-11-05",
            "clientInfo": {"name": "mcp-dev", "version": "1.0"},
            "capabilities": {},
        },
    }


def build_initialized_notification():
    return {
        "jsonrpc": "2.0",
        "method": "notifications/initialized",
        "params": {},
    }


def get_sse_url(mcp_url):
    if mcp_url.endswith("/mcp"):
        return mcp_url[: -len("/mcp")] + "/sse"
    return mcp_url


def read_sse_event(response):
    event = "message"
    data_lines = []
    while True:
        raw_line = response.readline()
        if not raw_line:
            if data_lines:
                return event, "\n".join(data_lines)
            raise RuntimeError("SSE connection closed before receiving a response")

        line = raw_line.decode("utf-8").rstrip("\r\n")
        if not line:
            if data_lines:
                return event, "\n".join(data_lines)
            continue

        field, separator, value = line.partition(":")
        if not separator:
            continue
        if value.startswith(" "):
            value = value[1:]

        if field == "event":
            event = value
            continue
        if field == "data":
            data_lines.append(value)


def wait_for_jsonrpc_response(response, request_id):
    while True:
        _, data = read_sse_event(response)
        try:
            payload = json.loads(data)
        except json.JSONDecodeError:
            continue
        if payload.get("id") == request_id:
            return payload


def read_sse_events_from_text(text):
    event = "message"
    data_lines = []
    for line in text.splitlines():
        if not line:
            if data_lines:
                yield event, "\n".join(data_lines)
                event = "message"
                data_lines = []
            continue

        field, separator, value = line.partition(":")
        if not separator:
            continue
        if value.startswith(" "):
            value = value[1:]
        if field == "event":
            event = value
            continue
        if field == "data":
            data_lines.append(value)

    if data_lines:
        yield event, "\n".join(data_lines)


def extract_jsonrpc_response(body, request_id):
    if not body:
        return {}

    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        pass
    else:
        if payload.get("id") == request_id or "error" in payload:
            return payload

    for _, data in read_sse_events_from_text(body):
        try:
            payload = json.loads(data)
        except json.JSONDecodeError:
            continue
        if payload.get("id") == request_id or "error" in payload:
            return payload

    raise RuntimeError(f"missing JSON-RPC response for id {request_id}")


def post_json_response(url, payload, headers=None):
    encoded_payload = json.dumps(payload).encode("utf-8")
    request_headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if headers:
        request_headers.update(headers)
    req = request.Request(
        url,
        data=encoded_payload,
        headers=request_headers,
        method="POST",
    )
    with request.urlopen(req, timeout=30) as response:
        body = response.read().decode("utf-8")
        return response.status, response.headers, body


def post_json(url, payload):
    status, _, body = post_json_response(url, payload)
    return status, body


def call_tool_via_sse(tool_name, arguments, mcp_url):
    sse_url = get_sse_url(mcp_url)
    with request.urlopen(sse_url, timeout=30) as response:
        while True:
            event, data = read_sse_event(response)
            if event == "endpoint":
                message_url = parse.urljoin(sse_url, data)
                break

        status, _ = post_json(message_url, build_initialize_payload())
        if status >= 400:
            raise RuntimeError(f"initialize failed with status {status}")
        wait_for_jsonrpc_response(response, 1)

        status, _ = post_json(message_url, build_initialized_notification())
        if status >= 400:
            raise RuntimeError(f"initialized notification failed with status {status}")

        status, _ = post_json(message_url, build_request_payload(tool_name, arguments))
        if status >= 400:
            raise RuntimeError(f"tool call failed with status {status}")
        return wait_for_jsonrpc_response(response, 1)


def call_tool_via_streamable_http(tool_name, arguments, mcp_url):
    streamable_headers = {"Accept": STREAMABLE_HTTP_ACCEPT}
    status, headers, body = post_json_response(
        mcp_url, build_initialize_payload(), streamable_headers
    )
    if status >= 400:
        raise RuntimeError(f"initialize failed with status {status}")

    extract_jsonrpc_response(body, 1)
    session_id = headers.get("mcp-session-id")
    if not session_id:
        raise RuntimeError("missing mcp-session-id from initialize response")

    session_headers = {
        "Accept": STREAMABLE_HTTP_ACCEPT,
        "Mcp-Session-Id": session_id,
    }
    status, _, _ = post_json_response(
        mcp_url, build_initialized_notification(), session_headers
    )
    if status >= 400:
        raise RuntimeError(f"initialized notification failed with status {status}")

    status, _, body = post_json_response(
        mcp_url, build_request_payload(tool_name, arguments), session_headers
    )
    if status >= 400:
        raise RuntimeError(f"tool call failed with status {status}")
    return extract_jsonrpc_response(body, 1)


def call_tool(tool_name, arguments):
    mcp_url = get_mcp_url()
    if mcp_url.endswith("/mcp"):
        try:
            return call_tool_via_streamable_http(tool_name, arguments, mcp_url)
        except error.HTTPError as exc:
            if exc.code == 404:
                return call_tool_via_sse(tool_name, arguments, mcp_url)
            raise

    payload = json.dumps(build_request_payload(tool_name, arguments)).encode("utf-8")
    req = request.Request(
        mcp_url,
        data=payload,
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    try:
        with request.urlopen(req, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except error.HTTPError as exc:
        if exc.code == 404 and mcp_url.endswith("/mcp"):
            return call_tool_via_sse(tool_name, arguments, mcp_url)
        raise


def print_usage(stream):
    stream.write("Usage: scripts/mcp-dev call <tool-name> [--key value ...]\n")


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        print_usage(sys.stderr)
        return 2

    if argv[0] != "call":
        sys.stderr.write(f"unknown command: {argv[0]}\n")
        print_usage(sys.stderr)
        return 2

    try:
        tool_name, arguments = parse_call_args(argv[1:])
        output_text = extract_output_text(call_tool(tool_name, arguments))
        if not output_text:
            sys.stderr.write("empty response content\n")
            return 1

        try:
            parsed = json.loads(output_text)
        except json.JSONDecodeError:
            print(output_text)
        else:
            print(json.dumps(parsed, ensure_ascii=False, indent=2))
        return 0
    except error.HTTPError as exc:
        sys.stderr.write(exc.read().decode("utf-8", errors="replace") + "\n")
        return 1
    except Exception as exc:
        sys.stderr.write(str(exc) + "\n")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
